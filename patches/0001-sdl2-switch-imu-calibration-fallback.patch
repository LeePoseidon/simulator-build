+           computed from them infinite or NaN, which silences motion input while
+           buttons and sticks keep working. Fall back to the factory default scale
+           when the calibration data cannot be trusted. */
+        const float defaultAccelScale = SDL_STANDARD_GRAVITY / SWITCH_ACCEL_SCALE;
+        const float defaultGyroScale = (float)M_PI / 180.0f / SWITCH_GYRO_SCALE;
