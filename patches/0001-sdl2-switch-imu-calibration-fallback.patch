+        float fGyroDivX = (float)sGyroSensCoeffX - (float)sGyroRawX;
+        float fGyroDivY = (float)sGyroSensCoeffY - (float)sGyroRawY;
+        float fGyroDivZ = (float)sGyroSensCoeffZ - (float)sGyroRawZ;
