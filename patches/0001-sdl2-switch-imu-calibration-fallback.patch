+        ctx->m_IMUScaleData.fAccelScaleX = (fAccelDivX > 0.0f) ? (SWITCH_ACCEL_SCALE_MULT / fAccelDivX * SDL_STANDARD_GRAVITY) : defaultAccelScale;
