 namespace Core::HID {
 
+namespace {
+// Tuning hook for controllers whose IMU has no usable factory calibration. A wrong gyro
+// sensitivity makes the accelerometer correction fight the integrated rotation, which is felt as
+// the aim springing back after a large movement. Lowering kp trades that snap back for a slow
+// drift; 0 disables the correction entirely (pure gyro integration). Defaults keep upstream
+// behaviour, so an unset environment changes nothing.
+f32 MotionEnvFloat(const char* name, f32 fallback) {
+    const char* env = std::getenv(name);
+    if (env == nullptr || *env == '\0') {
+        return fallback;
+    }
+    const f32 value = std::strtof(env, nullptr);
+    if (!std::isfinite(value) || value < 0.0f) {
+        return fallback;
+    }
+    return value;
+}
+} // Anonymous namespace
+
