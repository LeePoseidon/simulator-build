+// Beitong and similar Pro Controller clones report roughly twice the real angular velocity:
+// their IMU is configured for half the full scale range Nintendo uses, so the same physical
+// rotation produces twice the raw counts while we convert it with Nintendo's coefficients.
+// Measured on a Beitong pad: 65 degrees of physical pitch came through as 130 degrees of gyro
+// integration. That made the accelerometer correction fight the integrated attitude and drag it
+// back after large movements (the "snap back" on pitch, while yaw was unaffected because gravity
+// cannot observe yaw). Halving the rate makes both agree again (measured 1.00 against the
+// accelerometer afterwards).
+//
+//   EDEN_MOTION_GYRO_GAIN  overrides the default below; 1.0 gives the unscaled SDL rate
+//   EDEN_MOTION_LOG        prints one line per second with the raw rate, the gravity vector and
+//                          the integrated rotation, so a sensitivity error can be measured
+static constexpr f32 DefaultMotionGyroGain = 0.5f;
+
+static f32 MotionGyroGain() {
+    static const f32 gain = [] {
+        const char* env = std::getenv("EDEN_MOTION_GYRO_GAIN");
+        if (env == nullptr || *env == '\0') {
+            return DefaultMotionGyroGain;
+        }
+        const f32 value = std::strtof(env, nullptr);
+        if (!std::isfinite(value) || value < 0.1f || value > 10.0f) {
+            return DefaultMotionGyroGain;
+        }
+        return value;
+    }();
+    return gain;
+}
+
+static bool MotionLogEnabled() {
+    static const bool enabled = [] {
+        const char* env = std::getenv("EDEN_MOTION_LOG");
+        return env != nullptr && *env != '\0' && std::strcmp(env, "0") != 0;
+    }();
+    return enabled;
+}
