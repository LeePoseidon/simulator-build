     // Initialize PID constants with default values
-    SetPID(0.3f, 0.005f, 0.0f);
+    SetPID(MotionEnvFloat("EDEN_MOTION_KP", 0.3f), MotionEnvFloat("EDEN_MOTION_KI", 0.005f), 0.0f);
     SetGyroThreshold(ThresholdStandard);
     ResetQuaternion();
     ResetRotations();
