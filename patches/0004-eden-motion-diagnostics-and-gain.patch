+// Diagnostics for third party controllers whose IMU has no usable factory calibration.
+// Everything below is opt-in through the environment and is a no-op by default, so a normal
+// build behaves exactly like upstream.
+//
+//   EDEN_MOTION_GYRO_GAIN  multiplies the angular rate coming from SDL. Use it to compensate a
+//                          gyro sensitivity mismatch: if a 90 degree physical rotation only
+//                          produces ~60 degrees of in game rotation the gain is too low.
+//   EDEN_MOTION_LOG        prints one line per second with the raw rate, the gravity vector and
+//                          the integrated rotation, so a sensitivity error can be measured.
+static f32 MotionGyroGain() {
+    static const f32 gain = [] {
+        const char* env = std::getenv("EDEN_MOTION_GYRO_GAIN");
+        if (env == nullptr || *env == '\0') {
+            return 1.0f;
+        }
+        const f32 value = std::strtof(env, nullptr);
+        if (!std::isfinite(value) || value < 0.1f || value > 10.0f) {
+            return 1.0f;
+        }
+        return value;
+    }();
+    return gain;
+}
+
+static bool MotionLogEnabled() {
+    static const bool enabled = [] {
+        const char* env = std::getenv("EDEN_MOTION_LOG");
+        return env != nullptr && *env != '\0' && std::strcmp(env, "0") != 0;
+    }();
+    return enabled;
+}
